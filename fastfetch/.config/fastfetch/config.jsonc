{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo":{
    "source": "~/dotfiles/fastfetch/ascii2.txt",
    "type":"file",
    "padding": {
      "top": 1,
      "left": 4
    },
    "color":{
      "1": "white"
    }
  },

    "display":{ 
        "separator": " -> " 
    },

    "modules": [
        "break",

        "break",


        {
            "type": "custom",
            "format":"╭────────────────────── Hardware ──────────────────────╮",
            "outputColor": "red"
        },
        {
            "type": "title",
            "key": " PC",
            "format": "{user-name} on {host-name-colored}",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "│ ├󰍛 CPU",
            "showPeCoreCount": true,
            "format": "{name} {freq-max}",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍛 GPU",
            "showPeCoreCount": true,
            "format": "{vendor} {name}",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "│ ├󱛟 Disk",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "└ └󰍛 Memory",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format":"╰──────────────────────────────────────────────────────╯",
            "outputColor": "red"
        },

        "break",

        {
            "type": "custom",
            "format":"╭────────────────────── Software ──────────────────────╮",
            "outputColor": "red"
        },
        {
            "type": "os",
            "key": " OS",
            "keyColor": "yellow",
            "format": "{pretty-name} {version-id}"
            
        },
        {
            "type": "kernel",
            "key": "│ ├ Kernel",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "│ ├ Shell",
            "keyColor": "yellow",
            "format": "{1}"
        },
        {
            "type": "packages",
            "key": "│ ├󰏖 Packages",
            "keyColor": "yellow"
        },
        {
            "type": "command",
            "key": "│ ├ OS Age",
            "keyColor": "yellow",
            "text": " birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "└ └ Uptime",
            "keyColor": "yellow"
        },

        "break",

        {
            "type": "de",
            "key": " DE",
            "keyColor": "blue",
            "format": "{1}"
        },
        {
            "type": "wm",
            "key": "│ ├ Compositor",
            "keyColor": "blue",
            "format": "{1}"
        },
        {
            "type": "lm",
            "key": "│ ├ Login",
            "keyColor": "blue",
            "format": "{1}"
        },
        {
            "type": "terminal",
            "key": "│ ├ Terminal",
            "keyColor": "blue",
            "format": "{1}"
        },
        {
            "type": "terminalfont",
            "key": "└ └ Font",
            "keyColor": "blue",
            "format": "{name}"
        },
        {
            "type": "custom",
            "format":"╰──────────────────────────────────────────────────────╯",
            "outputColor": "red"
        },
        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": "20"
        }
    ]
}

